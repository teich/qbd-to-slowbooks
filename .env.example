# The Postgres database qbd-exporter loads (read-only access is enough).
QBD_POSTGRES_URL=postgresql://reader:password@localhost:5432/database
# Optional; qbd-exporter's default.
QBD_POSTGRES_SCHEMA=quickbooks_ingest

# The SlowBooks Pro server, and an admin-role API token for it
# (Settings -> API Tokens). Admin is needed to restore the baseline backup.
SLOWBOOKS_URL=https://books.example.com
SLOWBOOKS_TOKEN=sbp_replace-me

# The backup `reset` restores before every load. Made once with `baseline`.
SLOWBOOKS_BASELINE_BACKUP=

# Needed on a Postgres SlowBooks server (2.25.0 refuses to restore its own
# Postgres backups through the API). A shell command, run on this machine,
# that puts the baseline back; {baseline} becomes the backup's filename.
# Example for SlowBooks' docker-compose stack on this machine:
# SLOWBOOKS_RESET_COMMAND=docker compose -f /opt/slowbooks/docker-compose.yml exec -T slowbooks sh -c 'pg_restore -d "$DATABASE_URL" --clean --if-exists /app/backups/{baseline}'
SLOWBOOKS_RESET_COMMAND=
